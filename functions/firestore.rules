rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Publiczne zestawienia nie zawierają danych kontaktowych ani tekstu użytkownika.
    match /league/{week} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 100;
    }
    match /leaderboard/{week}/entries/{uid} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 100;
    }
    // Ranking wyzwania dnia: tylko nickId, kraj i km — tak samo publiczne jak leaderboard.
    match /daily/{date}/entries/{uid} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 100;
    }
    match /players/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
    }
    // runs, limity i wewnętrzne kolekcje nigdy nie są dostępne klientowi.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
