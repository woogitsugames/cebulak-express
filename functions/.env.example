# Skopiuj do firebase/.env (nie commituj pliku z ustawieniami).
# Po włączeniu App Check na platformach web/Android/iOS można ustawić true.
REQUIRE_APP_CHECK=false
# Dozwolone źródła żądań analityki; wpisz prawdziwe domeny portali.
# Schematy Capacitor są istotne na Androidzie i iOS.
ANALYTICS_ALLOWED_ORIGINS=https://example.com,capacitor://localhost,https://localhost
