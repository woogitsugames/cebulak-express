+    await page.reload();
+    await expect(page.locator('.ce-onboarding')).toBeVisible();
+  });
+
+  test('po wyborze kraju i miasta onboarding się nie powtarza, a trasa trafia do menu', async ({ page }) => {
+    await page.goto(FRESH);
