{
  "name": "cebulak-express-firebase",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.cjs",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=lib/index.cjs --packages=external",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --config vitest.config.ts tests/unit.test.ts",
    "test:emulator": "vitest run --config vitest.config.ts tests/emulator.test.ts tests/rules.test.ts --maxWorkers=1 --no-file-parallelism",
    "test": "npm run build && firebase emulators:exec --config ../firebase.json --project demo-cebulak-express --only auth,firestore,functions \"npm run test:emulator\""
  },
  "dependencies": {
    "firebase-admin": "13.4.0",
    "firebase-functions": "6.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/node": "22.16.0",
    "esbuild": "0.25.5",
    "firebase": "11.10.0",
    "firebase-tools": "14.12.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
