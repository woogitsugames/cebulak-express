{
  "name": "cebulak-express",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run && node --test tools/licenses.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:artifact": "npm run build && node scripts/build-artifact.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "test:firebase": "npm --prefix functions run test",
    "ios:sync": "npm run build && cap sync ios && npm run ios:assets",
    "balance": "tsc --noEmit -p tools/balance/tsconfig.json && node tools/balance/run.mjs",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "ios:assets": "npx --yes @capacitor/assets@3.0.5 generate --ios --assetPath assets --splashBackgroundColor '#14654F'",
    "prebuild": "node tools/licenses.mjs",
    "store:shots": "node tools/store-shots/shoot.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "@playwright/test": "1.56.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "8.0.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/filesystem": "8.0.0",
    "@capacitor/haptics": "8.0.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.0",
    "@capacitor/splash-screen": "8.0.0",
    "@capacitor/status-bar": "8.0.4",
    "firebase": "11.10.0"
  }
}
